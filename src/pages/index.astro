---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Credentials from '../components/Credentials.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CtaBanner from '../components/CtaBanner.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Independence from '../components/Independence.astro';
import { site } from '../data/site';
import { practiceAreas } from '../data/practiceAreas';
import { geoAreas } from '../data/geoAreas';
import { homeFaqs } from '../data/faqs';
import { qualifications } from '../data/credentials';
import { siteImages } from '../data/siteImages';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (h: string) => (h.startsWith('http') ? h : `${base}${h}`);

const areaIcons: Record<string, string> = {
  'construction-defect':
    'M2.25 21h19.5M3.75 3h16.5M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21',
  'cost-and-delay-claims':
    'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z',
  mediation:
    'M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z',
};

---

<BaseLayout
  title="Construction Expert Witness in VA, MD, DC, WV & DE | Hassan Consulting Group"
  description="Independent expert opinions and testimony for construction dispute matters in Virginia, Maryland, Washington, D.C., West Virginia, and Delaware. 45 years in construction and 20 years testifying."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 to-white">
    <div class="container mx-auto px-4 py-14 lg:py-20">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="eyebrow">{site.tagline}</span>
          <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-[3.4rem] leading-[1.1] text-ink mb-6 animate-fade-in">
            Construction Expert Witness for <span class="text-primary">Construction Disputes</span>
          </h1>
          <p class="text-lg md:text-xl text-slate-600 mb-8 max-w-xl animate-fade-in-delay">
            Independent expert opinions and testimony for construction dispute matters in Virginia, Maryland, Washington, D.C., West Virginia, and Delaware — grounded in 45 years of construction, a Ph.D. in construction management, and 20 years of testimony.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-delay-2">
            <a href={withBase('/contact')} class="btn-accent text-lg px-8 py-4">Request a Consultation</a>
            <a href={withBase('/expert-witness')} class="btn-outline text-lg px-8 py-4">Construction Expert Witness Services</a>
          </div>
        </div>

        <div class="relative animate-fade-in">
          <div class="relative rounded-xl overflow-hidden shadow-card-hover aspect-[4/3] lg:aspect-[5/4]">
            <Image
              src={siteImages.hero}
              alt="Structural work in progress on a commercial construction site"
              class="w-full h-full object-cover"
              width={1000}
              height={750}
              sizes="(min-width: 1024px) 560px, 100vw"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute inset-3 rounded-lg border border-accent/50 pointer-events-none"></div>
          </div>
          <div class="absolute -bottom-5 -left-3 sm:-left-5 bg-white rounded-xl shadow-card-hover p-4 hidden md:flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-accent text-white font-display font-bold text-lg flex items-center justify-center">45+</div>
            <div>
              <div class="font-bold text-ink text-sm">Years in Construction</div>
              <div class="text-sm text-slate-500">Ph.D. · P.E. · Admitted VA &amp; D.C.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Credentials strip -->
  <Credentials />

  <!-- Core value proposition -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <span class="eyebrow">One focus</span>
          <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-5">An expert your case can stand on</h2>
          <p class="text-slate-600 mb-4 text-lg">
            Hassan Consulting Group provides independent expert opinions and testimony for construction dispute matters, with field investigation and review of engineering documents, project photos, court complaints, expert reports, and testimony.
          </p>
          <p class="text-slate-600 mb-8">
            We prepare Expert Evaluation Reports for clients and the court system. Every opinion is measured against the contract, the plans, the applicable building codes, and recognized industry standards — grounded analysis of causation, standard of care, and damages that a trier of fact can rely on.
          </p>
          <a href={withBase('/expert-witness')} class="text-primary font-semibold hover:text-primary-dark inline-flex items-center gap-2">
            Explore construction expert witness services
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a href={withBase('/cv/dr-mohamed-hassan-cv.pdf')} target="_blank" rel="noopener" class="block mt-5 text-primary font-semibold hover:text-primary-dark underline underline-offset-2">
            View Curriculum Vitae
          </a>
        </div>
        <div class="card p-8">
          <h3 class="font-display font-semibold text-xl text-ink mb-5">Qualifications</h3>
          <ul class="space-y-3">
            {qualifications.map((q) => (
              <li class="feature-item text-sm sm:text-base">
                <span>{q}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Independence -->
  <Independence dark={true} />

  <!-- Brand band -->
  <section class="relative">
    <Image src={siteImages.homeBand} alt="A construction project underway" class="w-full h-[320px] md:h-[420px] object-cover" width={1600} height={420} sizes="100vw" loading="lazy" />
    <div class="absolute inset-0 bg-ink/70"></div>
    <div class="absolute inset-0 flex items-center">
      <div class="container mx-auto px-4 text-center">
        <span class="eyebrow-light">Building Harmony</span>
        <p class="font-display font-semibold text-3xl md:text-5xl text-white max-w-3xl mx-auto leading-tight">One Resolution at a Time</p>
        <p class="text-white/80 max-w-xl mx-auto mt-4">Resolving commercial and residential construction disputes and defects with clear, credible expert analysis.</p>
      </div>
    </div>
  </section>

  <!-- Practice areas -->
  <section class="bg-slate-50 py-20">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="eyebrow">What I handle</span>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-4">Areas of Expertise</h2>
        <p class="text-slate-600 text-lg">Focused construction expertise for the matters that put projects and portfolios at risk.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {practiceAreas.map((p) => (
          <a href={withBase(`/${p.slug}`)} class="card card-hover p-7 flex flex-col">
            <div class="w-12 h-12 rounded-md bg-primary text-white flex items-center justify-center mb-5">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d={areaIcons[p.slug]} /></svg>
            </div>
            <h3 class="font-display font-bold text-xl text-ink mb-2">{p.title}</h3>
            <p class="text-sm text-slate-600 flex-1">{p.blurb}</p>
            <span class="mt-5 text-sm font-semibold text-primary inline-flex items-center gap-2">
              Learn more
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <ProcessSteps dark={true} />

  <!-- Jurisdictions -->
  <section class="bg-white py-20">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="eyebrow">Where I practice</span>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-ink mb-4">Serving Five Jurisdictions</h2>
        <p class="text-slate-600 text-lg">Independent expert opinions and testimony for construction dispute matters in Virginia, Maryland, Washington, D.C., West Virginia, and Delaware.</p>
      </div>
      <div class="flex flex-wrap justify-center gap-3 max-w-3xl mx-auto mb-10">
        {geoAreas.map((g) => (
          <a href={withBase(`/expert-witness/${g.slug}`)} class="area-tag text-base">{g.name}</a>
        ))}
        <span class="area-tag text-base">West Virginia</span>
        <span class="area-tag text-base">Delaware</span>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FaqAccordion faqs={homeFaqs} heading="Frequently Asked Questions" />

  <!-- CTA -->
  <CtaBanner
    heading="Request Construction Expert Consultation"
    sub="Tell us about your case and related issues. We will review the complaint and the answer to the complaint and advise you accordingly."
  />
</BaseLayout>
