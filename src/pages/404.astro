---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (h: string) => (h.startsWith('http') ? h : `${base}${h}`);
---

<BaseLayout
  title="Page Not Found | Hassan Consulting Group"
  description="The page you're looking for doesn't exist or has moved. Explore our construction expert witness, defect, cost, delay, and mediation services."
>
  <section class="bg-white py-24">
    <div class="container mx-auto px-4 text-center max-w-xl">
      <span class="eyebrow">404</span>
      <h1 class="font-display font-bold text-4xl md:text-5xl text-ink mb-4 mt-3">Page not found</h1>
      <p class="text-slate-600 mb-8">That page doesn't exist or has moved. Try one of these instead:</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={withBase('/')} class="btn-primary">Back to Home</a>
        <a href={withBase('/expert-witness')} class="btn-outline">Construction Expert Witness</a>
        <a href={withBase('/contact')} class="btn-outline">Request Consultation</a>
      </div>
    </div>
  </section>
</BaseLayout>
