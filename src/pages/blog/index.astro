---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { site } from '../../data/site';
import { blogImages } from '../../data/blogImages';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (h: string) => (h.startsWith('http') ? h : `${base}${h}`);

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const cards = await Promise.all(
  posts.map(async (post) => {
    const hero = blogImages[post.id];
    const thumb = await getImage({ src: hero.src, width: 640, height: 400, fit: 'cover' });
    return { post, thumb, alt: hero.alt };
  })
);

const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${site.name} Insights`,
  url: Astro.url.href,
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: new URL(withBase(`/blog/${post.id}`), Astro.site ?? Astro.url.origin).href,
    datePublished: post.data.pubDate.toISOString(),
  })),
};
---

<BaseLayout
  title="Insights — Construction Expert Witness Guides & Analysis | Hassan Consulting Group"
  description="Expert analysis on construction defects, cost and delay claims, expert witness reports, building-code compliance, and construction disputes in Virginia, Washington, D.C., and Maryland."
  jsonLd={[blogLd]}
>
  <PageHeader
    eyebrow="Insights"
    title="Insights & Expert Analysis"
    sub="Plain-English, standards-grounded analysis on construction disputes, defects, and claims — written by a practicing construction expert witness for counsel, contractors, owners, and insurers."
  />

  <section class="bg-white py-16">
    <div class="container mx-auto px-4">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {cards.map(({ post, thumb, alt }) => (
          <a href={withBase(`/blog/${post.id}`)} class="card card-hover overflow-hidden flex flex-col">
            <img src={thumb.src} alt={alt} width={640} height={400} loading="lazy" decoding="async" class="w-full h-48 object-cover" />
            <div class="p-6 flex flex-col flex-1">
              <span class="category-pill w-fit mb-3">{post.data.category}</span>
              <h2 class="font-display font-bold text-xl text-ink mb-2">{post.data.title}</h2>
              <p class="text-slate-600 text-sm mb-4 flex-1">{post.data.description}</p>
              <p class="text-slate-400 text-xs">{dateFmt(post.data.pubDate)}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
