---
import { navGroups, type NavGroup, type NavLink } from '../data/nav';
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => {
  if (href.startsWith('#') || href.startsWith('http')) return href;
  const [path, hash] = href.split('#');
  const full = `${base}${path === '/' ? '/' : path}`;
  return hash ? `${full}#${hash}` : full;
};
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const matches = (href: string) => {
  const target = `${base}${href}`.replace(/\/$/, '') || '/';
  return current === target || current.startsWith(`${target}/`);
};
// A child is active on its own page or a sub-page, unless a more specific sibling matches.
const isChildActive = (group: NavGroup, link: NavLink) =>
  matches(link.href) &&
  !group.children.some((other) => other !== link && other.href.startsWith(`${link.href}/`) && matches(other.href));
const isGroupActive = (group: NavGroup) => group.children.some((link) => isChildActive(group, link));
const isHome = current === (base || '/');
const chevron = 'M19 9l-7 7-7-7';
---

<header
  x-data="{ mobileOpen: false }"
  class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-slate-200"
>
  <nav class="container mx-auto px-4" aria-label="Main">
    <div class="flex items-center justify-between gap-4 h-24 sm:h-28 2xl:h-32">
      <a href={withBase('/')} aria-label={`${site.name} home`} class="flex items-center shrink-0 p-1">
        <img
          src={withBase('/brand/hcg-logo-header.svg')}
          alt={site.name}
          width="1926"
          height="645"
          class="w-[220px] sm:w-[276px] xl:w-[300px] 2xl:w-[340px] h-auto"
          decoding="async"
        />
      </a>

      <!-- Desktop nav -->
      <div class="hidden xl:flex items-center gap-5 2xl:gap-7">
        {navGroups.map((group, i) => (
          <div
            class="relative"
            x-data="{ open: false, pointer: '' }"
            @pointerenter="if ($event.pointerType === 'mouse') open = true"
            @pointerleave="if ($event.pointerType === 'mouse') open = false"
            @focusout="if (!$el.contains($event.relatedTarget)) open = false"
            @keydown.escape="if (open) { open = false; $refs.trigger.focus() }"
            @click.outside="open = false"
          >
            <button
              type="button"
              x-ref="trigger"
              class:list={['nav-link nav-trigger', isGroupActive(group) && 'active']}
              aria-controls={`nav-menu-${i}`}
              aria-expanded="false"
              x-bind:aria-expanded="open"
              @pointerdown="pointer = $event.pointerType"
              @click="open = pointer === 'mouse' ? true : !open; pointer = ''"
            >
              {group.label}
              <svg class="w-4 h-4 transition-transform" x-bind:class="open && 'rotate-180'" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={chevron} /></svg>
            </button>
            <div
              id={`nav-menu-${i}`}
              x-show="open"
              x-cloak
              x-transition.opacity.duration.150ms
              class="absolute left-0 top-full pt-3 z-50"
            >
              <ul class="min-w-[17rem] rounded-md bg-white py-2 shadow-card-hover ring-1 ring-slate-200">
                {group.children.map((link) => {
                  const active = isChildActive(group, link);
                  return (
                    <li>
                      <a
                        href={withBase(link.href)}
                        class:list={['nav-dropdown-link', active && 'active']}
                        aria-current={active ? 'page' : undefined}
                        target={link.newTab ? '_blank' : undefined}
                        rel={link.newTab ? 'noopener' : undefined}
                      >
                        <span class="block font-semibold">{link.label}</span>
                        {link.description && <span class="block text-xs text-slate-500 mt-0.5">{link.description}</span>}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="hidden xl:flex items-center gap-3 shrink-0">
        <a
          href={site.phoneHref}
          aria-label={`Call ${site.name} at ${site.phoneDisplay}`}
          class="btn-outline text-[0.9375rem] 2xl:text-base px-4 2xl:px-5 py-2.5 whitespace-nowrap inline-flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          <span class="2xl:hidden">Call</span>
          <span class="hidden 2xl:inline">{site.phoneDisplay}</span>
        </a>
        <a href={withBase('/contact')} class="btn-accent text-[0.9375rem] 2xl:text-base px-4 2xl:px-5 py-2.5 whitespace-nowrap">Request Consultation</a>
      </div>

      <!-- Mobile controls -->
      <div class="flex items-center gap-1.5 xl:hidden">
        <a
          href={site.phoneHref}
          aria-label={`Call ${site.name} at ${site.phoneDisplay}`}
          class="hidden sm:inline-flex items-center justify-center w-11 h-11 rounded-lg border-2 border-accent text-accent-dark transition-colors hover:bg-accent hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
        </a>
        <button
          @click="mobileOpen = !mobileOpen"
          class="p-2.5 text-slate-700 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          aria-label="Toggle menu"
          aria-controls="mobile-menu"
          x-bind:aria-expanded="mobileOpen"
        >
          <svg x-show="!mobileOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
          <svg x-show="mobileOpen" x-cloak class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" x-show="mobileOpen" x-cloak x-transition class="xl:hidden max-h-[calc(100dvh-6rem)] sm:max-h-[calc(100dvh-7rem)] overflow-y-auto overscroll-contain pb-4 border-t border-slate-200 pt-3">
      <div class="flex flex-col">
        <a href={withBase('/')} class:list={['nav-link-mobile', isHome && 'active']} aria-current={isHome ? 'page' : undefined}>Home</a>
        {navGroups.map((group, i) => (
          <div x-data={`{ open: ${isGroupActive(group)} }`} class="border-t border-slate-100">
            <button
              type="button"
              @click="open = !open"
              class:list={['nav-link-mobile w-full flex items-center justify-between text-left', isGroupActive(group) && 'active']}
              aria-controls={`mobile-nav-${i}`}
              aria-expanded={isGroupActive(group) ? 'true' : 'false'}
              x-bind:aria-expanded="open"
            >
              {group.label}
              <svg class="w-5 h-5 transition-transform" x-bind:class="open && 'rotate-180'" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={chevron} /></svg>
            </button>
            <ul id={`mobile-nav-${i}`} x-show="open" x-cloak class="pb-3 pl-4 space-y-1">
              {group.children.map((link) => {
                const active = isChildActive(group, link);
                return (
                  <li>
                    <a
                      href={withBase(link.href)}
                      class:list={['block py-2 text-[0.9375rem] transition-colors hover:text-primary', active ? 'text-primary font-semibold' : 'text-slate-600']}
                      aria-current={active ? 'page' : undefined}
                      target={link.newTab ? '_blank' : undefined}
                      rel={link.newTab ? 'noopener' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
        <a href={site.phoneHref} class="btn-outline text-center mt-3 inline-flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          Call {site.phoneDisplay}
        </a>
        <a href={withBase('/contact')} class="btn-accent text-center mt-3 text-base">Request Consultation</a>
      </div>
    </div>
  </nav>
</header>
