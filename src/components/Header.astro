---
import { navItems } from '../data/nav';
import { site } from '../data/site';
const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => {
  if (href.startsWith('#') || href.startsWith('http')) return href;
  const [path, hash] = href.split('#');
  const full = `${base}${path === '/' ? '/' : path}`;
  return hash ? `${full}#${hash}` : full;
};
const isActive = (href: string) => {
  if (href === '/') return pathname === base + '/' || pathname === base || pathname === '/';
  return pathname.startsWith(base + href);
};
---

<header
  x-data="{ mobileOpen: false }"
  class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-slate-200"
>
  <nav class="container mx-auto px-4">
    <div class="flex items-center justify-between h-20">
      <a href={withBase('/')} aria-label={`${site.name} home`} class="flex items-center shrink-0 p-1">
        <img
          src={withBase('/brand/hcg-logo-lockup-compact.svg')}
          alt={site.name}
          width="604"
          height="120"
          class="h-10 sm:h-11 w-auto"
          decoding="async"
        />
      </a>

      <!-- Desktop nav -->
      <div class="hidden lg:flex items-center gap-4 xl:gap-6">
        {navItems.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={['nav-link', isActive(item.href) && 'active']}
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- CTA -->
      <div class="hidden lg:flex items-center gap-3 shrink-0">
        <a
          href={site.phoneHref}
          aria-label={`Call ${site.name} at ${site.phoneDisplay}`}
          class="btn-outline text-[0.9375rem] xl:text-base px-4 xl:px-5 py-2.5 whitespace-nowrap inline-flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          <span class="xl:hidden">Call</span>
          <span class="hidden xl:inline">{site.phoneDisplay}</span>
        </a>
        <a href={withBase('/contact')} class="btn-accent text-[0.9375rem] xl:text-base px-5 py-2.5 whitespace-nowrap">Request Consultation</a>
      </div>

      <!-- Mobile controls -->
      <div class="flex items-center gap-1.5 lg:hidden">
        <a
          href={site.phoneHref}
          aria-label={`Call ${site.name} at ${site.phoneDisplay}`}
          class="hidden sm:inline-flex items-center justify-center w-11 h-11 rounded-lg border-2 border-accent text-accent-dark transition-colors hover:bg-accent hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
        </a>
        <button
          @click="mobileOpen = !mobileOpen"
          class="p-2.5 text-slate-700 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          aria-label="Toggle menu"
          aria-controls="mobile-menu"
          x-bind:aria-expanded="mobileOpen"
        >
          <svg x-show="!mobileOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
          <svg x-show="mobileOpen" x-cloak class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" x-show="mobileOpen" x-cloak x-transition class="lg:hidden pb-4 border-t border-slate-200 pt-3">
      <div class="flex flex-col">
        <a href={withBase('/')} class:list={['nav-link-mobile', isActive('/') && 'active']}>Home</a>
        {navItems.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={['nav-link-mobile', isActive(item.href) && 'active']}
          >
            {item.label}
          </a>
        ))}
        <a href={site.phoneHref} class="btn-outline text-center mt-3 inline-flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          Call {site.phoneDisplay}
        </a>
        <a href={withBase('/contact')} class="btn-accent text-center mt-3 text-base">Request Consultation</a>
      </div>
    </div>
  </nav>
</header>
