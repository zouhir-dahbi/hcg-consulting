---
import { site } from '../data/site';
import { practiceAreas } from '../data/practiceAreas';
import { geoAreas } from '../data/geoAreas';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (href.startsWith('http') ? href : `${base}${href}`);
const year = new Date().getFullYear();
---

<footer class="bg-ink text-slate-300">
  <div class="container mx-auto px-4 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <div class="md:col-span-1">
        <a href={withBase('/')} aria-label={`${site.name} home`} class="inline-flex items-center w-full max-w-[280px] mb-5 p-1">
          <img
            src={withBase('/brand/hcg-header-logo-white.svg')}
            alt={site.name}
            width="1032"
            height="384"
            class="w-full max-w-[280px] h-auto"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="text-sm text-slate-400 mb-5">
          Construction expert witness and construction-management consulting for commercial and residential projects in Virginia, Maryland, Washington, D.C., West Virginia, and Delaware.
        </p>
      </div>

      <div>
        <h2 class="font-display font-semibold text-white text-lg mb-4">Services</h2>
        <ul class="space-y-2 text-sm">
          <li><a href={withBase('/expert-witness')} class="hover:text-accent-light transition-colors">Construction Expert Witness</a></li>
          {practiceAreas.map((p) => (
            <li><a href={withBase(`/${p.slug}`)} class="hover:text-accent-light transition-colors">{p.title}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="font-display font-semibold text-white text-lg mb-4">Jurisdictions</h2>
        <ul class="space-y-2 text-sm">
          {geoAreas.map((g) => (
            <li><a href={withBase(`/expert-witness/${g.slug}`)} class="hover:text-accent-light transition-colors">{g.name}</a></li>
          ))}
          <li>West Virginia</li>
          <li>Delaware</li>
          <li><a href={withBase('/blog')} class="hover:text-accent-light transition-colors">Insights</a></li>
          <li><a href={withBase('/about')} class="hover:text-accent-light transition-colors">About Dr. Hassan</a></li>
        </ul>
      </div>

      <div>
        <h2 class="font-display font-semibold text-white text-lg mb-4">Get in Touch</h2>
        <ul class="space-y-3 text-sm">
          <li>
            <a href={site.phoneHref} class="inline-flex items-center gap-2 font-semibold hover:text-accent-light transition-colors">
              <svg class="w-4 h-4 text-accent-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              {site.phoneDisplay}
            </a>
          </li>
          <li>
            <a href={site.emailHref} class="inline-flex items-center gap-2 hover:text-accent-light transition-colors">
              <svg class="w-4 h-4 text-accent-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              {site.email}
            </a>
          </li>
          <li class="text-slate-400 leading-relaxed">
            <span class="block font-semibold text-slate-300">Office</span>
            <a href={site.address.mapsHref} target="_blank" rel="noopener noreferrer" class="hover:text-accent-light transition-colors">
              {site.address.line1}<br />{site.address.line2}
            </a>
          </li>
          <li>
            <a href={withBase('/contact')} class="btn-accent text-sm mt-1">Request Consultation</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 text-sm text-slate-500 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-center sm:text-left">
      <p>&copy; {year} {site.legalName}. All rights reserved. Information on this site is for general purposes and is not legal advice.</p>
      <ul class="flex items-center justify-center gap-6">
        <li><a href={withBase('/privacy')} class="hover:text-accent-light transition-colors">Privacy Policy</a></li>
        <li><a href={withBase('/terms')} class="hover:text-accent-light transition-colors">Terms of Use</a></li>
      </ul>
    </div>
  </div>
</footer>
