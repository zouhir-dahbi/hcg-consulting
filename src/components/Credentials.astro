---
import { credentials } from '../data/credentials';

interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<section class:list={[dark ? 'bg-ink' : 'bg-white', 'py-14 border-y', dark ? 'border-white/10' : 'border-slate-200']}>
  <div class="container mx-auto px-4">
    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-8">
      {credentials.map((c) => (
        <div class="text-center lg:text-left">
          <dt class="sr-only">{c.label}</dt>
          <dd>
            <div class:list={['font-display font-bold text-4xl md:text-5xl mb-1', dark ? 'text-white' : 'text-primary']}>{c.stat}</div>
            <div class:list={['text-sm font-medium uppercase tracking-wide', dark ? 'text-slate-400' : 'text-slate-500']}>{c.label}</div>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
