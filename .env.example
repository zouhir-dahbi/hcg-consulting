# Copy to .env for local development. Values are inlined into the client
# bundle at build time (they are PUBLIC_*), so keep this file out of git
# (.env is gitignored) — the deploy workflow sets the production values.

# Where the consultation form submits. This is your Cloudflare Worker URL
# (see cloudflare/worker/ for the ready-to-deploy endpoint). Leave empty
# locally until the Worker is deployed; the form then shows a
# "call or email us instead" state instead of dead-ending.
PUBLIC_FORM_ENDPOINT=

# Cloudflare Turnstile public site key (the free, privacy-friendly captcha).
# Leave empty to skip the widget locally; the Worker won't verify a token
# if none is present.
PUBLIC_TURNSTILE_SITE_KEY=
